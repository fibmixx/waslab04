<% content_for :title, "Wall of Tweets · RoR Edition" %>

<div class="container">
  <h1 class="wottitle">Wall of Tweets · RoR Edition</h1>
  <div class="subtitle">A minimal wall for quick thoughts. Clean and focused.</div>

  <%= render "form", tweet: Tweet.new %>

  <div id="tweets">
    <% @tweets.group_by { |tweet| tweet.created_at.to_date }.each do |date, tweets| %>
      <div class="date-sep"><%= date.strftime("%A, %B %-d, %Y") %></div>
      <% tweets.each do |tweet| %>
        <%= render tweet %>
      <% end %>
    <% end %>
  </div>
</div>
