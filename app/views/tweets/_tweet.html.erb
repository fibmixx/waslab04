<div class="wotitem" id="<%= dom_id tweet %>">
  <div class="likes">
    <span class="numlikes" id="showLikes_<%= tweet.id %>"><%= tweet.likes %></span>
    <span class="smallfont">likes</span>
    <div class="button_to">
      <% authored = Array(session[:authored_ids]).map(&:to_i).include?(tweet.id) %>
      <% if authored %>
        <%= button_to "destroy", tweet, method: :delete, class: "btn-danger" %>
      <% else %>
        <% liked = Array(session[:liked_ids]).map(&:to_i).include?(tweet.id) %>
        <%= button_to (liked ? "liked" : "like"), like_tweet_path(tweet), method: :put,
              class: ("btn-disabled" if liked), disabled: liked %>
      <% end %>
    </div>
  </div>
  <div class="item">
    <h4><em><%= tweet.author %></em> · <%= tweet.created_at.strftime("%H:%M") %></h4>
    <p><%= tweet.content %></p>
  </div>
</div>
