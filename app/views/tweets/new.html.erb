<% content_for :title, "New tweet" %>

<div class="container">
  <h1 class="wottitle">Wall of Tweets · RoR Edition</h1>
  <div class="subtitle">Compose a new tweet</div>

  <% if notice.present? %>
    <div class="flash"><%= notice %></div>
  <% end %>
  <% if alert.present? %>
    <div class="flash flash--alert"><%= alert %></div>
  <% end %>

  <%= render "form", tweet: @tweet %>

  <div class="page-actions">
    <%= link_to "Back to tweets", root_path %>
  </div>
</div>
