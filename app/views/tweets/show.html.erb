<% content_for :title, "Tweet" %>

<div class="container">
  <h1 class="wottitle">Wall of Tweets · RoR Edition</h1>
  <div class="subtitle">Tweet detail</div>

  <% if notice.present? %>
    <div class="flash"><%= notice %></div>
  <% end %>
  <% if alert.present? %>
    <div class="flash flash--alert"><%= alert %></div>
  <% end %>

  <%= render @tweet %>

  <div class="page-actions">
    <%= link_to "Edit this tweet", edit_tweet_path(@tweet) %>
    <%= link_to "Back to tweets", root_path %>
  </div>
</div>
